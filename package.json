{
  "name": "readio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"vite\" \"node --watch --env-file=.env server.js\"",
    "build": "vite build",
    "start": "node --env-file=.env server.js",
    "test": "node --test",
    "test:browser": "concurrently --kill-others --names mock,web \"node tests/mock-api.mjs\" \"PORT=8790 vite --port 8791\""
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "vite": "^6.4.5"
  }
}
